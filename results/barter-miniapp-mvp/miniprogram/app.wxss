page {
  background: #f6f7fb;
  font-size: 28rpx;
  color: #1f2937;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.subtitle {
  color: #6b7280;
  font-size: 24rpx;
}

.btn-primary {
  background: #1d4ed8;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  text-align: center;
}

.btn-secondary {
  background: #e5e7eb;
  color: #111827;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  text-align: center;
}
